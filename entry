<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>WAC Exhibition Entries</title>
  <style>
    html, body { margin: 0; padding: 0; height: 100%; background: #f7f5f0; }
    iframe { border: none; width: 100%; height: 100vh; display: block; }
  </style>
</head>
<body>
  <iframe id="portalFrame" title="WAC Exhibition Entry Portal"></iframe>

  <script>
    // ⚠️ REPLACE with your actual Apps Script Web App deployment URL
    // (Deploy > Manage deployments > copy the "Web app" URL)
    const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzAVzwDrDiGHkhzCA_e2G93p3ObQGyYDN8wToH8Oo2HW0uY8nb4hmZ8IW7W30dSznRnGQ/exec';

    const params = new URLSearchParams(window.location.search);
    const token = params.get('token');

    let src = APPS_SCRIPT_URL + '?page=entry';
    if (token) {
      src += '&token=' + encodeURIComponent(token);
    }

    document.getElementById('portalFrame').src = src;
  </script>
</body>
</html>
